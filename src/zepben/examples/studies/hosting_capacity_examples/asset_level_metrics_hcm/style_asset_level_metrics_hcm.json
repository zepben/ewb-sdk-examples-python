[
  {
    "id": "asset-thermal-max_loading_pct-line",
    "name": "Thermal Max Loading Lines",
    "type": "line",
    "paint": {
      "line-width": ["interpolate", ["linear"], ["zoom"], 8, 3.0, 12, 4.8, 15, 6.2],
      "line-opacity": 0.92,
      "line-color": ["match", ["get", "bucket"], 0, "#2c7bb6", 1, "#fdae61", 2, "#f46d43", 3, "#d73027", "#8f8f8f"]
    },
    "metadata": {
      "zb:legend": {
        "label": "Maximum Loading",
        "states": [
          { "label": "Below 90%", "properties": { "bucket": 0 } },
          { "label": "90-100%", "properties": { "bucket": 1 } },
          { "label": "100-130%", "properties": { "bucket": 2 } },
          { "label": "Above 130%", "properties": { "bucket": 3 } }
        ]
      }
    },
    "filter": ["all", ["==", ["get", "metric_key"], "max_loading_pct"], ["==", ["get", "geom_kind"], "line"]]
  },
  {
    "id": "asset-thermal-max_loading_pct-point",
    "name": "Thermal Max Loading Points",
    "type": "circle",
    "paint": {
      "circle-radius": 6,
      "circle-opacity": 0.92,
      "circle-stroke-color": "#ffffff",
      "circle-stroke-width": 1,
      "circle-color": ["match", ["get", "bucket"], 0, "#2c7bb6", 1, "#fdae61", 2, "#f46d43", 3, "#d73027", "#8f8f8f"]
    },
    "filter": ["all", ["==", ["get", "metric_key"], "max_loading_pct"], ["==", ["get", "geom_kind"], "point"]]
  },
  {
    "id": "asset-thermal-max_loading_pct-label",
    "name": "Thermal Max Loading Labels",
    "type": "symbol",
    "minzoom": 13,
    "layout": { "symbol-placement": "point", "text-field": ["get", "value_label"], "text-size": 12 },
    "paint": { "text-color": "#1f2a44", "text-halo-color": "#ffffff", "text-halo-width": 1.4 },
    "filter": ["==", ["get", "metric_key"], "max_loading_pct"]
  },
